rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal couple app: tighten later (e.g. Firebase Auth) if the URL is public.
    match /birthdayWishes/{docId} {
      allow read, write: if true;
    }
    match /birthdayPunishments/{docId} {
      allow read, write: if true;
    }
    match /birthdayMemories/{docId} {
      allow read, write: if true;
    }
    match /couplePlans/{docId} {
      allow read, write: if true;
    }
    match /coupleNotes/{docId} {
      allow read, write: if true;
    }
  }
}
